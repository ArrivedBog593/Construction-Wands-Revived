{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/construction-wands-revived",
        "sources": "https://github.com/SrNadien/Construction-Wands-Revived"
    },
    "license": "${license}",
    "icon": "logo.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "nadiendev.constructionwand.ConstructionWandFabric"
        ],
        "client": [
            "nadiendev.constructionwand.ConstructionWandFabricClient"
        ],
        "jei_mod_plugin": [
            "nadiendev.constructionwand.integrations.jei.ConstructionWandJeiPlugin"
        ],
        "emi": [
            "nadiendev.constructionwand.integrations.emi.ConstructionWandEmiPlugin"
        ],
        "rei_client": [
            "nadiendev.constructionwand.integrations.rei.ConstructionWandReiPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "forgeconfigapiport": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
